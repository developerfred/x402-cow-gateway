# x402 CoW Gateway — operator configuration
# Copy to .env (never commit .env — it holds the operator wallet key).

# --- Agent-facing x402 (seller leg) ---
PAYTO_ADDRESS=0x0000000000000000000000000000000000000000   # collection wallet; sweeps the fee to codingsh.eth
FACILITATOR_URL=https://facilitator.example.com             # x402 facilitator that verifies/settles on PAYMENT_NETWORK
PAYMENT_NETWORK=eip155:8453                                  # Base
SELLER_SCHEME=exact                                         # exact (v1) | batch-settlement (scale)

# --- Upstream x402.cow.fi (buyer leg) ---
OPS_WALLET_PRIVATE_KEY=0x...                                # funds the cow.fi tab ($0.001/quote); keep secret
OPS_RPC_URL=https://mainnet.base.org                        # RPC for the upstream payment network
UPSTREAM_BASE_URL=https://x402.cow.fi                       # upstream quote server

# --- Fee policy ---
FEE_POLICY=tiered                                          # flat | bps | tiered
FEE_RECIPIENT=codingsh.eth                                  # all margin accrues here
# FEE_PER_CALL=0.001        # when FEE_POLICY=flat
# FEE_BPS=10000             # when FEE_POLICY=bps (+100%)

# --- Local run ---
RUN_SERVER=1
PORT=3000
